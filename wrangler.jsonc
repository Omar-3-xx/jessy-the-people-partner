// Jessy on Cloudflare Workers, built by the OpenNext adapter.
// Free plan throughout: KV and D1 inside their free allowance, no R2, Durable Objects or Images binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jessy-people-partner",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    // fetch() may only reach public addresses: the outbound calls go to Gemini and Tavily.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Jessy's first model. A binding, so there is no API key anywhere: Cloudflare authenticates
  // the call itself, and the allowance is this account's daily neurons rather than Gemini's
  // twenty calls a day. Dropping this line puts her back on Gemini alone.
  "ai": {
    "binding": "AI",
  },
  // Her answers and her voice for the fixed common questions (src/lib/law/common.ts).
  "kv_namespaces": [
    {
      "binding": "COMMON",
      "id": "c392bbfbde834e239ed4226f0d55a273",
    },
  ],
  // What people say she got wrong, kept only when they press send (src/lib/law/reports.ts).
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "jessy-reports",
      "database_id": "dc7ae8d5-c77d-4984-a03b-fb041bf72e4a",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
