// Jessy on Cloudflare Workers, built by the OpenNext adapter.
// Free plan throughout: no R2, KV, D1, Durable Objects or Images binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jessy-people-partner",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    // fetch() may only reach public addresses: the outbound calls go to Gemini and Tavily.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Jessy's first model. A binding, so there is no API key anywhere: Cloudflare authenticates
  // the call itself, and the allowance is this account's daily neurons rather than Gemini's
  // twenty calls a day. Dropping this line puts her back on Gemini alone.
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
  },
}
